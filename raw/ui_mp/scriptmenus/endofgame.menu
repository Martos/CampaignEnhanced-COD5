#undef HINT_TEXT
#define HINT_TEXT( itemIndex, titleArg, visArg ) \
	itemDef \
	{ \
		type			ITEM_TYPE_TEXT \
		rect			SECTION_X_OFFSET 0 230 64 CHOICE_HORIZONTAL_ALIGN CHOICE_VERTICAL_ALIGN \
		origin			CHOICE_ORIGIN( itemIndex ) \
		forecolor		1 1 1 0.8 \
		exp				text( titleArg );\
		textstyle 		ITEM_TEXTSTYLE_SHADOWED \
		textfont		CHOICE_TEXTFONT \
		textscale		TEXTSIZE_SMALL \
		textstyle		CHOICE_TEXTSTYLE \
		textAlign		ITEM_ALIGN_MIDDLE_LEFT \
		textAlignX		SECTION_TEXT_OFFSET_X \
		visible 		visArg \
		autowrapped \
		decoration \
	} \
	PREPROC_SHADER_DRAW_ALIGNED_VIS( (SECTION_X_OFFSET-14) 27 10 10 CHOICE_HORIZONTAL_ALIGN CHOICE_VERTICAL_ALIGN, CHOICE_ORIGIN( itemIndex ), "ui_arrow_right", 1 1 1 0.4, 0, 1, 1 1 1 1, when( visArg ) )

#undef HINT_TEXT_CLASS
#define HINT_TEXT_CLASS( itemIndex, titleArg, visArg ) \
	itemDef \
	{ \
		type			ITEM_TYPE_TEXT \
		rect			SECTION_X_OFFSET 0 230 64 CHOICE_HORIZONTAL_ALIGN CHOICE_VERTICAL_ALIGN \
		origin			CHOICE_ORIGIN( itemIndex ) \
		forecolor		CE_COLOR_TITLE \
		exp				text( "@CE_CLASS_SELECTED" );\
		textstyle 		ITEM_TEXTSTYLE_SHADOWED \
		textfont		CHOICE_TEXTFONT \
		textscale		TEXTSIZE_SMALL \
		textstyle		CHOICE_TEXTSTYLE \
		textAlign		ITEM_ALIGN_MIDDLE_LEFT \
		textAlignX		SECTION_TEXT_OFFSET_X \
		visible 		visArg \
		autowrapped \
		decoration \
	} \
	itemDef \
	{ \
		type			ITEM_TYPE_TEXT \
		rect 			SECTION_X_OFFSET_CLASS 0 230 64 CHOICE_HORIZONTAL_ALIGN CHOICE_VERTICAL_ALIGN \
		origin			CHOICE_ORIGIN( itemIndex ) \
		forecolor		CE_COLOR_TITLE \
		exp				text( titleArg );\
		textstyle 		ITEM_TEXTSTYLE_SHADOWED \
		textfont		CHOICE_TEXTFONT \
		textscale		TEXTSIZE_SMALL \
		textstyle		CHOICE_TEXTSTYLE \
		textAlign		ITEM_ALIGN_MIDDLE_LEFT \
		textAlignX		SECTION_TEXT_OFFSET_X \
		visible 		visArg \
		autowrapped \
		decoration \
	} \
	PREPROC_SHADER_DRAW_ALIGNED_VIS( (SECTION_X_OFFSET-14) 27 10 10 CHOICE_HORIZONTAL_ALIGN CHOICE_VERTICAL_ALIGN, CHOICE_ORIGIN( itemIndex ), "ui_arrow_right", 1 1 1 0.4, 0, 1, 1 1 1 1, when( visArg ) )



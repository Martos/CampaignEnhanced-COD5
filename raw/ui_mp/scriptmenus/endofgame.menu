#define CHOICE_Y_START			40

#define CHOICE_GROUP			"main"
#define CHOICE_SEP_1			2

#undef SECTION_X_OFFSET_CLASS
#define SECTION_X_OFFSET_CLASS	(SECTION_X_OFFSET+108)

#define STYLE_PC	1
